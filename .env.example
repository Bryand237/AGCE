# Copier ce fichier en .env et remplacer les valeurs avant de démarrer.
# .env ne doit JAMAIS être commité (déjà exclu par .gitignore).

DB_USER=dr_mbala
DB_PASSWORD=dr_mbala
DB_NAME=carriere_db
# Port de la base sur CETTE machine : docker-compose.yml ne le publie que sur
# 127.0.0.1, la base n'est donc pas joignable depuis le réseau.
DR_PORT=51213

# Utilisé quand Next.js tourne EN LOCAL (npm run dev) et que seul
# Postgres tourne dans Docker : l'hôte est "localhost".
DATABASE_URL=postgresql://dr_mbala:dr_mbala@localhost:51213/carriere_db

# Quand toute la stack (app + db) tourne dans docker-compose, l'hôte
# devient le nom du service Docker, pas "localhost" :
# DATABASE_URL=postgresql://dr_mbala:dr_mbala@db:5432/carriere_db

NODE_ENV=production

ADMIN_USERNAME="MBALA"
ADMIN_PASSWORD=dr_mbala_max